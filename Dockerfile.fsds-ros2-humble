# Dockerfile für die FSDS ROS2-Bridge (Humble, Ubuntu 22.04)
FROM osrf/ros:humble-desktop

ENV DEBIAN_FRONTEND=noninteractive

# Ubuntus "universe"-Repo aktivieren: clang-12 (das AirSim/setup.sh für
# Ubuntu 22.04 fest vorgibt) liegt dort, ist im osrf/ros-Basisimage aber
# standardmaessig nicht aktiviert.
RUN apt-get update && apt-get install -y --no-install-recommends software-properties-common \
    && add-apt-repository universe \
    && apt-get update

# Build-Tools und Abhängigkeiten, die AirLib/setup.sh + die Bridge brauchen
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    clang \
    clang-12 \
    clang++-12 \
    libc++-12-dev \
    libc++abi-12-dev \
    cmake \
    git \
    git-lfs \
    libcurl4-openssl-dev \
    libeigen3-dev \
    libyaml-cpp-dev \
    python3-colcon-common-extensions \
    python3-rosdep \
    python3-pip \
    ros-humble-cv-bridge \
    ros-humble-image-transport \
    ros-humble-tf2-geometry-msgs \
    wget \
    && rm -rf /var/lib/apt/lists/*

RUN git lfs install

# rosdep ist im osrf/ros Image meist schon initialisiert; falls nicht, hier nachholen
RUN rosdep update || true

# Der Container erwartet, dass das Repo per Bind-Mount unter
# /root/Formula-Student-Driverless-Simulator eingehängt wird (siehe run-Skript).
WORKDIR /root/Formula-Student-Driverless-Simulator

# Praktischer Alias, damit man im Container nicht immer alles neu sourcen muss
RUN echo "source /opt/ros/humble/setup.bash" >> /root/.bashrc

CMD ["/bin/bash"]
